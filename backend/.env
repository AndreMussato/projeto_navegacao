#O arquivo .env é usado para armazenar variáveis de ambiente da aplicação.

#Ele permite configurar valores como:
#Porta do servidor
#credenciais de banco de dados
#chaves de API

PORT = 3333

# String de conexão com o banco de dados Postgres
# Contém:
# - usuário (postgres)
# - senha (postdba)
# - host (localhost)
# - porta do banco (5433)
# - nome do banco (bdpizzariafatec)
# - schema utilizado (public)
DATABASE_URL="postgres://postgres:postdba@localhost:5433/bdpizzariafatec=public"